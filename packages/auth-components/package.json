{
  "name": "@sudobility/auth-components",
  "version": "1.0.12",
  "description": "Firebase Auth UI components for React with full i18n support",
  "type": "module",
  "main": "dist/index.umd.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "components",
    "firebase",
    "auth",
    "authentication",
    "login",
    "signup",
    "i18n",
    "typescript"
  ],
  "author": "John Q Huang",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@heroicons/react": "^2.2.0",
    "@sudobility/components": "^5.3.48",
    "@sudobility/design": "^1.1.66",
    "firebase": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sudobility/components": "^5.3.48",
    "@sudobility/design": "^1.1.66",
    "@sudobility/types": "^1.9.76",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitejs/plugin-react": "^5.1.0",
    "ajv": "^8.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "firebase": "^12.4.0",
    "i18next": "^25.6.0",
    "jsdom": "^24.0.0",
    "prettier": "~3.9.10",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.3.1",
    "typescript": "~6.0.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.52.5",
    "@rollup/rollup-linux-x64-musl": "4.52.5"
  },
  "trustedDependencies": [
    "@firebase/util",
    "protobufjs"
  ]
